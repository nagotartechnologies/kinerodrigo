# Copiar a .env.local y completar. Nunca commitear .env.local.

# Base de datos Turso (obligatorias)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Firma de la sesión (obligatoria). Generar con: openssl rand -base64 48
JWT_SECRET=

# Cloudinary (documentos de pacientes y logo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp - Green API
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_URL=
GREEN_API_TEST_MODE=false
# Si se define, el webhook exige Authorization: Bearer <token> (mismo valor en "Webhook URL Token" de Green API)
GREEN_API_WEBHOOK_TOKEN=

# true = no envía mensajes reales (TestProvider)
WHATSAPP_TEST_MODE=false

# URL pública de la app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto que la Netlify Scheduled Function envía en x-cron-secret
CRON_SECRET=
